---
import '@/styles/global.css';
import { GA_MEASUREMENT_ID } from 'astro:env/client';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Search from '@/components/Search.astro';
import { DEFAULT_OG_IMAGE, SITE_NAME, SITE_URL } from '@/config';
import { languages, ui, type Lang } from '@/i18n';
import { absoluteUrl } from '@/lib/seo';
import { pageOf, viewAttributes, type ViewEvent } from '@/lib/analytics';

interface Props {
  lang: Lang;
  /** Full document title, already in its final form (see the page components). */
  title: string;
  description: string;
  /** Root-relative path of the equivalent page in each language. */
  alternates: Record<Lang, string>;
  /** Social preview, root-relative. Defaults to DevPedia's own image. */
  image?: { path: string; width: number; height: number; type: string; alt?: string };
  /** Present on guides: announced as an article with its dates. */
  article?: { created: Date; lastUpdated: Date; section: string };
  /** Structured data objects, one `<script type="application/ld+json">` each. */
  jsonLd?: Record<string, unknown>[];
  /** Product view event of topic, subtopic and guide pages (see lib/analytics). The home has none. */
  view?: ViewEvent;
}

const {
  lang,
  title,
  description,
  alternates,
  image = DEFAULT_OG_IMAGE,
  article,
  jsonLd = [],
  view,
} = Astro.props;
const copy = ui[lang];
const canonicalUrl = absoluteUrl(Astro.url.pathname, SITE_URL);
const alternateUrl = (code: Lang) => absoluteUrl(alternates[code], SITE_URL);
const imageUrl = absoluteUrl(image.path, SITE_URL);
// Analytics only runs on the production origin, so previews and local builds are never measured.
const analyticsHost = new URL(SITE_URL).hostname;
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <script is:inline>
      if (localStorage.getItem('theme') === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((code) => (
      <link rel="alternate" hreflang={code} href={alternateUrl(code)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrl('es')} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={copy.ogLocale} />
    {languages
      .filter((code) => code !== lang)
      .map((code) => (
        <meta property="og:locale:alternate" content={ui[code].ogLocale} />
      ))}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:type" content={image.type} />
    {image.alt && <meta property="og:image:alt" content={image.alt} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.created.toISOString()} />
        <meta property="article:modified_time" content={article.lastUpdated.toISOString()} />
        <meta property="article:section" content={article.section} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {image.alt && <meta name="twitter:image:alt" content={image.alt} />}
    {jsonLd.map((data) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(data).replaceAll('<', '\\u003c')}
      />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {import.meta.env.PROD && GA_MEASUREMENT_ID && <script
      is:inline
      define:vars={{ gaId: GA_MEASUREMENT_ID, analyticsHost }}
    >
      (() => {
        if (window.location.hostname !== analyticsHost) {
          return;
        }
        try {
          if (localStorage.getItem('analytics-excluded') === 'true') {
            return;
          }
        } catch {
          return;
        }
        if (window.gtag) {
          return;
        }
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          // gtag's dataLayer contract is the Arguments object, not a rest array.
          // eslint-disable-next-line prefer-rest-params
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId);
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
        document.head.appendChild(script);
      })();
    </script>}
  </head>
  <body
    class="font-sans text-neutral-300 light:text-neutral-700 antialiased"
    {...viewAttributes(view)}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-500 focus:px-3 focus:py-2 focus:text-neutral-950"
    >
      {copy.skipToContent}
    </a>
    <SiteHeader lang={lang} alternates={alternates} page={view && pageOf(view)} />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-16 sm:px-6">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <Search lang={lang} />
    <script>
      import { initAnalytics } from '@/lib/analytics';

      initAnalytics();
    </script>
  </body>
</html>
