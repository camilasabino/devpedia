---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../config';
import { ui } from '../i18n';

const copy = ui.es.home;
---

<BaseLayout lang="es" title={copy.title} description={copy.description} alternates={{ es: ui.es.homePath, en: ui.en.homePath }}>
  <h1 class="font-display text-4xl font-bold text-neutral-50 light:text-neutral-900 sm:text-5xl">{SITE_NAME}</h1>
  <p class="mt-3 font-mono text-sm text-accent-400 light:text-accent-700">{SITE_DESCRIPTION}</p>
  <p class="mt-8 text-neutral-400 light:text-neutral-600">{copy.status}</p>
</BaseLayout>
