---
// A guide: breadcrumb, where it sits (section and position in its sequence), title,
// description, last update and reading time, table of contents, body, sharing and the
// previous/next guide. The body is the page; everything around it stays secondary.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../../../src/components/Icon.astro';
import Breadcrumb from './Breadcrumb.astro';
import GuidePager from './GuidePager.astro';
import GuideShare from './GuideShare.astro';
import GuideToc from './GuideToc.astro';
import { SITE_NAME, SITE_URL, pageTitle } from '../config';
import { format, ui, type Lang } from '../i18n';
import { getContent } from '../lib/content';
import { formatMonthYear, guideSequence, readingMinutes, tocEntries } from '../lib/guide';
import { absoluteUrl, breadcrumbJsonLd, imageType, techArticleJsonLd } from '../lib/seo';
import { coverOf, topicVisual } from '../lib/topic-visuals';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const copy = ui[lang];
const content = await getContent();
const { index } = content;

const guide = index.guide(lang, id)!;
const topic = index.topic(lang, guide.topic)!;
const subtopic = guide.subtopic ? index.subtopic(lang, guide.subtopic) : undefined;
// The node whose hub lists this guide, and whose sequence previous/next walks.
const parent = subtopic ?? topic;
const parentPath = index.pathOf(lang, subtopic ? 'subtopic' : 'topic', parent.id)!;

const crumbs = [
  { label: topic.title, href: index.pathOf(lang, 'topic', topic.id)! },
  ...(subtopic ? [{ label: subtopic.title, href: parentPath }] : []),
];

const path = index.pathOf(lang, 'guide', id)!;
const section = parent.sections?.find((candidate) => candidate.id === guide.section);
// Search results show where a guide sits: topic › subtopic › section.
const searchContext = [topic.title, subtopic?.title, section?.title].filter(Boolean).join(' › ');
const imagePath = guide.cover ?? coverOf(topic.id, subtopic?.id);
const image = { path: imagePath, width: 1200, height: 630, type: imageType(imagePath) };
const articleSection = parent.title;
const jsonLd = [
  techArticleJsonLd({
    siteUrl: SITE_URL,
    lang,
    path,
    homePath: copy.homePath,
    title: guide.title,
    description: guide.description,
    section: articleSection,
    created: guide.created,
    lastUpdated: guide.lastUpdated,
    imagePath: image.path,
  }),
  breadcrumbJsonLd(
    [
      { name: SITE_NAME, path: copy.homePath },
      ...crumbs.map((crumb) => ({ name: crumb.label, path: crumb.href })),
      { name: guide.title, path },
    ],
    SITE_URL,
  ),
];

const entry = content.guideEntry(lang, id);
const { Content, headings } = await render(entry);
const toc = tocEntries(headings);
const minutes = readingMinutes(entry.body ?? '');

const sequence = guideSequence(index, lang, id);
const pagerLink = (target?: { id: string; title: string }) =>
  target && { title: target.title, href: index.pathOf(lang, 'guide', target.id)! };

const visual = topicVisual(topic.id);
// A section's overview guide is titled like the section; repeating it above the h1 adds nothing.
const sectionLabel = section && section.title !== guide.title ? section : undefined;
---

<BaseLayout
  lang={lang}
  title={pageTitle(guide.title)}
  description={guide.description}
  alternates={index.alternatesOf('guide', id)}
  image={image}
  article={{ created: guide.created, lastUpdated: guide.lastUpdated, section: articleSection }}
  jsonLd={jsonLd}
>
  {/* The side column is kept even without a table of contents, so the body sits at the
      same position and width on every guide. */}
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:items-start lg:gap-x-12">
    {
      toc.length > 0 && (
        <aside class="hidden lg:col-start-2 lg:row-start-1 lg:block lg:self-stretch">
          <div class="sticky top-24 max-h-[calc(100dvh-8rem)] overflow-y-auto pb-4">
            <GuideToc lang={lang} headings={toc} variant="sidebar" />
          </div>
        </aside>
      )
    }

    <div class="min-w-0 lg:col-start-1 lg:row-start-1">
      <Breadcrumb lang={lang} crumbs={crumbs} current={guide.title} />

      <article class="mt-8">
        <span hidden data-pagefind-meta="topic">{searchContext}</span>
        <header>
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-neutral-500 light:text-neutral-600">
            <Icon name={topic.icon} class={`h-4 w-4 ${visual.text}`} decorative />
            {
              sectionLabel && (
                <>
                  <a
                    href={`${parentPath}#${sectionLabel.id}`}
                    class={`inline-flex min-h-6 items-center hover:underline ${visual.text}`}
                  >
                    {sectionLabel.title}
                  </a>
                  <span aria-hidden="true">·</span>
                </>
              )
            }
            {
              sequence.total > 1 && (
                <span>{format(copy.guide.position, { position: sequence.position, total: sequence.total })}</span>
              )
            }
          </p>
          <h1
            class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-balance break-words text-neutral-50 light:text-neutral-900 sm:text-4xl lg:text-[2.625rem]"
          >
            {guide.title}
          </h1>
          <p class="mt-4 max-w-[var(--guide-measure)] text-lg leading-relaxed text-neutral-300 light:text-neutral-700">
            {guide.description}
          </p>
          <p class="mt-5 flex flex-wrap items-center gap-x-2 font-mono text-xs text-neutral-500 light:text-neutral-600">
            <span>
              {copy.guide.updated}{' '}
              <time datetime={guide.lastUpdated.toISOString().slice(0, 10)}>{formatMonthYear(guide.lastUpdated, lang)}</time>
            </span>
            <span aria-hidden="true">·</span>
            <span>{format(copy.guide.readingTime, { minutes })}</span>
          </p>
        </header>

        {
          toc.length > 0 && (
            <div class="mt-8 lg:hidden">
              <GuideToc lang={lang} headings={toc} variant="inline" />
            </div>
          )
        }

        <div class="prose-guide mt-10" data-pagefind-body data-heading-anchor-label={copy.guide.headingAnchor}>
          <Content />
        </div>

        <footer class="mt-14 border-t border-white/10 pt-6 light:border-black/10">
          <GuideShare lang={lang} title={guide.title} url={absoluteUrl(path, SITE_URL)} />
        </footer>
      </article>

      <div class="mt-10">
        <GuidePager
          lang={lang}
          parentTitle={parent.title}
          previous={pagerLink(sequence.previous)}
          next={pagerLink(sequence.next)}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Permalinks on section headings. Astro's slugger already gave every heading an `id`
  // at build time (the TOC links work without this script); this only adds the visible
  // link, so without JavaScript the headings simply have none. The label template is
  // rendered into the page so it follows the page's language.
  const body = document.querySelector<HTMLElement>('.prose-guide[data-heading-anchor-label]');
  if (body) {
    const label = body.dataset.headingAnchorLabel!;
    for (const heading of body.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]')) {
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', label.replace('{heading}', heading.textContent?.trim() ?? ''));
      heading.append(anchor);
      // Lets the table of contents move focus to the section it jumps to.
      heading.tabIndex = -1;
    }
  }
</script>
