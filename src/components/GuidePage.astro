---
// Provisional guide page: breadcrumb, title, lead, last-updated date and the body.
// The guide reading experience is redesigned in a later milestone.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import { SITE_NAME, SITE_URL, pageTitle } from '../config';
import { ui, type Lang } from '../i18n';
import { getContent } from '../lib/content';
import { breadcrumbJsonLd, imageType, techArticleJsonLd } from '../lib/seo';
import { coverOf } from '../lib/topic-visuals';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const copy = ui[lang];
const content = await getContent();
const { index } = content;

const guide = index.guide(lang, id)!;
const topic = index.topic(lang, guide.topic)!;
const subtopic = guide.subtopic ? index.subtopic(lang, guide.subtopic) : undefined;

const crumbs = [
  { label: topic.title, href: index.pathOf(lang, 'topic', topic.id)! },
  ...(subtopic ? [{ label: subtopic.title, href: index.pathOf(lang, 'subtopic', subtopic.id)! }] : []),
];

const path = index.pathOf(lang, 'guide', id)!;
const section = (subtopic ?? topic).sections?.find((candidate) => candidate.id === guide.section);
// Search results show where a guide sits: topic › subtopic › section.
const searchContext = [topic.title, subtopic?.title, section?.title].filter(Boolean).join(' › ');
const imagePath = guide.cover ?? coverOf(topic.id, subtopic?.id);
const image = { path: imagePath, width: 1200, height: 630, type: imageType(imagePath) };
const articleSection = (subtopic ?? topic).title;
const jsonLd = [
  techArticleJsonLd({
    siteUrl: SITE_URL,
    lang,
    path,
    homePath: copy.homePath,
    title: guide.title,
    description: guide.description,
    section: articleSection,
    created: guide.created,
    lastUpdated: guide.lastUpdated,
    imagePath: image.path,
  }),
  breadcrumbJsonLd(
    [
      { name: SITE_NAME, path: copy.homePath },
      ...crumbs.map((crumb) => ({ name: crumb.label, path: crumb.href })),
      { name: guide.title, path },
    ],
    SITE_URL,
  ),
];

const { Content } = await render(content.guideEntry(lang, id));
const lastUpdated = guide.lastUpdated.toISOString().slice(0, 10);
const lastUpdatedLabel = new Intl.DateTimeFormat(copy.htmlLang, { dateStyle: 'long', timeZone: 'UTC' }).format(
  guide.lastUpdated,
);
---

<BaseLayout
  lang={lang}
  title={pageTitle(guide.title)}
  description={guide.description}
  alternates={index.alternatesOf('guide', id)}
  image={image}
  article={{ created: guide.created, lastUpdated: guide.lastUpdated, section: articleSection }}
  jsonLd={jsonLd}
>
  <article>
    <span hidden data-pagefind-meta="topic">{searchContext}</span>
    <Breadcrumb lang={lang} crumbs={crumbs} />
    <h1 class="mt-6 font-display text-4xl font-bold text-neutral-50 light:text-neutral-900">{guide.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-neutral-400 light:text-neutral-600">{guide.description}</p>
    <p class="mt-3 font-mono text-xs text-neutral-500">
      {copy.guide.lastUpdated}: <time datetime={lastUpdated}>{lastUpdatedLabel}</time>
    </p>
    <div class="prose-guide mt-10" data-pagefind-body>
      <Content />
    </div>
  </article>
</BaseLayout>
