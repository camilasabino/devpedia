---
interface Props {
  name: string;
  class?: string;
  /**
   * Accessible name. Set it when the icon is the only content of a control; leave it
   * off (or pass `decorative`) when adjacent text already names the thing.
   */
  label?: string;
  /** Explicitly marks a purely decorative icon. Equivalent to omitting `label`. */
  decorative?: boolean;
}

const { name, class: className = 'h-5 w-5', label, decorative = false } = Astro.props;
const a11y =
  label && !decorative
    ? { role: 'img' as const, 'aria-label': label }
    : { 'aria-hidden': 'true' as const, focusable: 'false' as const };

