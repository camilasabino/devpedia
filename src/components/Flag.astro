---
interface Props {
  code: 'es' | 'en';
  class?: string;
}

const { code, class: className = 'h-3 w-4' } = Astro.props;
---

{
  code === 'es' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" class={`${className} rounded-[2px]`}>
      <rect width="24" height="16" fill="#75AADB" />
      <rect y="5.33" width="24" height="5.34" fill="#F4F5F0" />
      <circle cx="12" cy="8" r="1.7" fill="#F6B40E" stroke="#85340A" stroke-width="0.25" />
    </svg>
  ) : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" class={`${className} rounded-[2px]`}>
      <rect width="24" height="16" fill="#B22234" />
      <g fill="#F4F5F0">
        <rect y="1.23" width="24" height="1.23" />
        <rect y="3.69" width="24" height="1.23" />
        <rect y="6.15" width="24" height="1.23" />
        <rect y="8.62" width="24" height="1.23" />
        <rect y="11.08" width="24" height="1.23" />
        <rect y="13.54" width="24" height="1.23" />
      </g>
      <rect width="10.8" height="8.62" fill="#3C3B6E" />
    </svg>
  )
}
