---
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import { ui, type Lang } from '@/i18n';
import { trackAttributes, type PageKind } from '@/lib/analytics';

interface Props {
  lang: Lang;
  /** Root-relative path of the equivalent page in each language. */
  alternates: Record<Lang, string>;
  /** The page's conceptual node, reported by language_change. Absent on the home. */
  page?: { id: string; kind: PageKind };
}

const { lang, alternates, page } = Astro.props;
const copy = ui[lang];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const topicsClass =
  'flex h-11 items-center rounded-md px-1.5 font-mono text-xs text-neutral-400 light:text-neutral-600 transition-colors hover:text-accent-400 light:hover:text-accent-700 sm:h-9 sm:px-2.5';

const utilityClass =
  'flex h-11 cursor-pointer items-center justify-center rounded-md border border-white/10 light:border-black/10 text-neutral-400 light:text-neutral-600 transition-colors hover:border-accent-400/40 hover:text-accent-400 light:hover:border-accent-600/40 light:hover:text-accent-700 sm:h-9';

const searchTriggerClass =
  'col-span-2 flex h-11 w-full cursor-pointer items-center gap-2 rounded-md border border-white/10 light:border-black/10 bg-white/5 light:bg-black/[0.03] px-3 font-mono text-sm text-neutral-500 light:text-neutral-600 transition-colors hover:border-accent-400/40 hover:text-neutral-300 light:hover:border-accent-600/40 light:hover:text-neutral-700 sm:h-9 sm:w-auto sm:min-w-80 sm:max-w-sm sm:flex-1';
---

<header class="sticky top-0 z-40 border-b border-white/10 light:border-black/10 bg-[color-mix(in_srgb,var(--surface-bg)_85%,transparent)] backdrop-blur-md">
  <div class="mx-auto grid w-full max-w-5xl grid-cols-[1fr_auto] items-center gap-x-1.5 gap-y-2 px-4 py-2 sm:flex sm:gap-4 sm:px-6">
    <a
      href={copy.homePath}
      class="shrink-0 rounded-md text-lg text-neutral-100 light:text-neutral-900 transition-opacity hover:opacity-85 sm:text-xl"
    >
      <Wordmark />
    </a>

    <button
      id="search-trigger"
      type="button"
      aria-label={copy.search.triggerLabel}
      aria-haspopup="dialog"
      class={searchTriggerClass}
    >
      <Icon name="search" class="h-4 w-4 shrink-0" decorative />
      <span class="min-w-0 truncate" aria-hidden="true">
        {copy.search.triggerText}
      </span>
    </button>

    <div class="col-start-2 row-start-1 flex shrink-0 items-center gap-0.5 sm:col-auto sm:row-auto sm:ml-auto sm:gap-2">
      <nav aria-label={copy.nav.label}>
        <ul class="flex items-center">
          <li>
            <a href={`${copy.homePath}#topics`} class={topicsClass}>
              {copy.nav.topics}
            </a>
          </li>
        </ul>
      </nav>
      <a
        href={alternates[otherLang]}
        hreflang={otherLang}
        lang={otherLang}
        title={copy.localeToggle.title}
        aria-label={copy.localeToggle.label}
        class={`${utilityClass} gap-1.5 px-2 sm:px-2.5`}
        {...trackAttributes('language_change', { from: lang, to: otherLang, ...page })}
      >
        <Flag code={lang} class="h-3 w-4 shrink-0" />
        <span class="font-mono text-xs" aria-hidden="true">
          {lang.toUpperCase()}
        </span>
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>
