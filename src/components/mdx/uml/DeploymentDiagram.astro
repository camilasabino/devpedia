---
import DiagramFigure from '@/components/mdx/DiagramFigure.astro';

// UML deployment notation: nodes are 3D boxes with a «device» or «executionEnvironment»
// stereotype, artifacts sit inside them with the «artifact» stereotype, and the
// connections between nodes are communication paths.
//
// The caption is the diagram's accessible name, so it follows the language of the
// page it is rendered into (these figures are embedded from MDX and cannot be
// handed a `lang` prop).
import { langFromPath } from '@/i18n';

const CAPTION = {
  es: 'Diagrama de despliegue UML: dos availability zones, cada una con un execution environment que aloja el artifact payments.jar, y una base de datos compartida.',
  en: 'UML deployment diagram: two availability zones, each with an execution environment hosting the payments.jar artifact, and one shared database.',
} as const;

const caption = CAPTION[langFromPath(Astro.url.pathname)];
---

<DiagramFigure caption={caption} viewBox="0 0 660 330">
  <!-- Load balancer -->
  <g transform="translate(237 14)">
    <path d="M0 12 L12 0 H186 V62 L174 74 H0 Z" class="uml-shape" />
    <path d="M0 12 H174 V74 M174 12 L186 0" class="uml-line" />
  </g>

  <text x="324" y="42" text-anchor="middle" class="uml-stereotype">
    «device»
  </text>
  <text x="324" y="58" text-anchor="middle">
    Load Balancer
  </text>

  <!-- AZ A -->
  <g transform="translate(30 140)">
    <path d="M0 12 L12 0 H186 V62 L174 74 H0 Z" class="uml-shape" />
    <path d="M0 12 H174 V74 M174 12 L186 0" class="uml-line" />
  </g>

  <text x="117" y="166" text-anchor="middle" class="uml-stereotype">
    «executionEnvironment»
  </text>
  <text x="117" y="180" text-anchor="middle">
    AZ A · App Server
  </text>
  <rect x="33" y="188" width="168" height="22" rx="2" class="uml-shape" />
  <text x="117" y="203" text-anchor="middle" class="uml-label">
    «artifact» payments.jar
  </text>

  <!-- AZ B -->
  <g transform="translate(444 140)">
    <path d="M0 12 L12 0 H186 V62 L174 74 H0 Z" class="uml-shape" />
    <path d="M0 12 H174 V74 M174 12 L186 0" class="uml-line" />
  </g>

  <text x="531" y="166" text-anchor="middle" class="uml-stereotype">
    «executionEnvironment»
  </text>
  <text x="531" y="180" text-anchor="middle">
    AZ B · App Server
  </text>
  <rect x="447" y="188" width="168" height="22" rx="2" class="uml-shape" />
  <text x="531" y="203" text-anchor="middle" class="uml-label">
    «artifact» payments.jar
  </text>

  <!-- Database -->
  <g transform="translate(237 248)">
    <path d="M0 12 L12 0 H186 V62 L174 74 H0 Z" class="uml-shape" />
    <path d="M0 12 H174 V74 M174 12 L186 0" class="uml-line" />
  </g>

  <text x="324" y="276" text-anchor="middle" class="uml-stereotype">
    «device»
  </text>
  <text x="324" y="292" text-anchor="middle">
    PostgreSQL (primary)
  </text>

  <!-- Communication paths -->
  <path d="M270 90 L200 150" class="uml-line" />
  <text x="220" y="114" text-anchor="middle" class="uml-label">
    HTTPS
  </text>
  <path d="M378 90 L460 150" class="uml-line" />
  <text x="430" y="114" text-anchor="middle" class="uml-label">
    HTTPS
  </text>
  <path d="M160 216 L260 254" class="uml-line" />
  <text x="190" y="250" text-anchor="middle" class="uml-label">
    TCP 5432
  </text>
  <path d="M500 216 L400 254" class="uml-line" />
  <text x="470" y="250" text-anchor="middle" class="uml-label">
    TCP 5432
  </text>
</DiagramFigure>
