---
// Search overlay over the Pagefind index that `npm run build:devpedia` generates.
// Opened by the header's search button (#search-trigger).
import Icon from '../../../src/components/Icon.astro';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = ui[lang].search;

const PREVIEW_LIMIT = 5;

// The overlay's script is `is:inline` (it has to run before Pagefind is imported
// dynamically), so it cannot import the copy files. Every string it renders at
// runtime travels with the markup instead.
const scriptLabels = {
  resultCountOne: labels.resultCount.one,
  resultCountOther: labels.resultCount.other,
  showing: labels.showing,
  empty: labels.empty,
  emptyHint: labels.emptyHint,
  unavailable: labels.unavailable,
};
---

<div
  id="search-overlay"
  class="fixed inset-0 z-[100] hidden items-start justify-center bg-neutral-950/80 light:bg-white/90 backdrop-blur-sm sm:p-6 sm:pt-16"
  role="dialog"
  aria-modal="true"
  aria-label={labels.dialogLabel}
>
  <div class="card-surface flex h-full w-full flex-col sm:h-auto sm:max-h-[85vh] sm:max-w-3xl sm:rounded-2xl lg:max-w-4xl">
    <div class="flex items-center gap-3 border-b border-white/10 light:border-black/10 p-4">
      <Icon name="search" class="h-4 w-4 shrink-0 text-neutral-500 light:text-neutral-600" />
      <input
        id="search-input"
        type="text"
        placeholder={labels.placeholder}
        autocomplete="off"
        data-preview-limit={PREVIEW_LIMIT}
        data-labels={JSON.stringify(scriptLabels)}
        class="flex-1 bg-transparent pl-2 font-mono text-sm text-neutral-100 light:text-neutral-800 placeholder:text-neutral-500 light:placeholder:text-neutral-600 focus:outline-none"
      />
      <button
        id="search-close"
        type="button"
        aria-label={labels.closeLabel}
        class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center text-neutral-500 light:text-neutral-600 transition-colors hover:text-neutral-300 light:hover:text-neutral-600 sm:h-9 sm:w-9"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <div id="search-results" class="hidden flex-1 overflow-y-auto p-2"></div>

    <div id="search-footer" class="hidden items-center justify-between border-t border-white/10 light:border-black/10 p-3">
      <span id="search-count" class="font-mono text-xs text-neutral-500 light:text-neutral-600"></span>
      <button
        id="search-full"
        type="button"
        class="hidden cursor-pointer items-center gap-1.5 rounded-md border border-accent-400/30 light:border-accent-600/30 px-3 py-1.5 font-mono text-xs text-accent-400 light:text-accent-700 transition-colors hover:border-accent-400/60 light:hover:border-accent-600/60 hover:bg-accent-400/5 light:hover:bg-accent-600/5"
      >
        {labels.showAll}
        <Icon name="arrowRight" class="h-3.5 w-3.5" />
      </button>
    </div>
  </div>
</div>

<script>
  import { pagefindResultMatchesQuery } from '../../../src/lib/search-relevance';

  declare global {
    interface Window {
      pagefindResultMatchesQuery?: typeof pagefindResultMatchesQuery;
    }
  }

  window.pagefindResultMatchesQuery = pagefindResultMatchesQuery;
</script>

<script is:inline>
  const searchInputEl = document.getElementById('search-input');
  const PREVIEW_LIMIT = Number(searchInputEl?.dataset.previewLimit ?? '5');
  const LABELS = JSON.parse(searchInputEl?.dataset.labels ?? '{}');

  const fill = (template, values) =>
    String(template ?? '').replace(/\{(\w+)\}/g, (match, key) => (key in values ? values[key] : match));

  const trigger = document.getElementById('search-trigger');
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const closeBtn = document.getElementById('search-close');
  const resultsEl = document.getElementById('search-results');
  const footerEl = document.getElementById('search-footer');
  const countEl = document.getElementById('search-count');
  const fullBtn = document.getElementById('search-full');

  let pagefind = null;
  let pagefindFailed = false;
  let lastQuery = '';
  let requestToken = 0;

  async function ensurePagefind() {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      pagefindFailed = true;
      pagefind = null;
      // Visitors only see the plain "unavailable" copy; the actionable cause —
      // the index is generated by the build, so `astro dev` never has one —
      // stays here, where whoever is running the site locally will look.
      console.warn('[search] Pagefind index not found. Run `npm run build:devpedia` to generate it.');
    }
    return pagefind;
  }

  function escapeHtml(value) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function renderMessage(text) {
    if (!resultsEl) return;
    resultsEl.classList.remove('hidden');
    resultsEl.innerHTML = `<p class="p-4 font-mono text-xs text-neutral-500 light:text-neutral-600">${text}</p>`;
  }

  function renderResults(items, { full, total }) {
    if (!resultsEl || !footerEl || !countEl) return;

    resultsEl.classList.remove('hidden');
    resultsEl.innerHTML = '';
    const list = document.createElement('div');
    list.className = 'flex flex-col gap-1';

    for (const data of items) {
      const topic = data.meta?.topic ?? '';
      const title = data.meta?.title ?? '';
      const a = document.createElement('a');
      a.href = data.url;
      a.className = 'block rounded-lg p-3 transition-colors hover:bg-white/5 light:hover:bg-black/5';
      a.innerHTML = `
        <p class="font-mono text-[11px] uppercase tracking-wide text-accent-400 light:text-accent-700">${escapeHtml(topic)}</p>
        <p class="mt-1 font-display text-sm font-semibold text-neutral-100 light:text-neutral-800">${escapeHtml(title)}</p>
        <p class="mt-1 text-xs leading-relaxed text-neutral-400 light:text-neutral-600">${data.excerpt}</p>
      `;
      list.appendChild(a);
    }
    resultsEl.appendChild(list);

    if (full) {
      hideFooter();
      countEl.textContent =
        total === 1 ? LABELS.resultCountOne : fill(LABELS.resultCountOther, { count: total });
      resultsEl.insertAdjacentHTML(
        'afterbegin',
        `<p class="px-3 pb-2 pt-1 font-mono text-xs text-neutral-500 light:text-neutral-600">${countEl.textContent}</p>`
      );
    } else if (items.length < total) {
      footerEl.classList.remove('hidden');
      footerEl.classList.add('flex');
      countEl.textContent = fill(LABELS.showing, { shown: items.length, total });
      setFullButtonVisible(true);
    } else {
      hideFooter();
    }
  }

  function setFullButtonVisible(visible) {
    if (!fullBtn) return;
    fullBtn.classList.toggle('hidden', !visible);
    fullBtn.classList.toggle('flex', visible);
  }

  function hideFooter() {
    footerEl?.classList.add('hidden');
    footerEl?.classList.remove('flex');
    setFullButtonVisible(false);
  }

  function renderEmpty(query) {
    if (!resultsEl) return;
    resultsEl.classList.remove('hidden');
    resultsEl.innerHTML = `
      <div class="flex flex-col items-center gap-1 p-8 text-center">
        <p class="font-mono text-xs text-neutral-500 light:text-neutral-600">${fill(LABELS.empty, { query: escapeHtml(query) })}</p>
        <p class="text-xs text-neutral-500 light:text-neutral-600">${escapeHtml(LABELS.emptyHint ?? '')}</p>
      </div>
    `;
    hideFooter();
  }

  function resetSearch() {
    lastQuery = '';
    if (input) input.value = '';
    clearIdleResults();
  }

  function clearIdleResults() {
    if (resultsEl) {
      resultsEl.innerHTML = '';
      resultsEl.classList.add('hidden');
    }
    hideFooter();
  }

  async function search(query, { full = false } = {}) {
    const token = ++requestToken;
    if (!query.trim()) {
      clearIdleResults();
      return;
    }

    const pf = await ensurePagefind();
    if (token !== requestToken) return;
    if (!pf) {
      renderMessage(LABELS.unavailable ?? '');
      return;
    }

    const outcome = full ? await pf.search(query) : await pf.debouncedSearch(query);
    if (token !== requestToken || outcome === null) return;

    const { results } = outcome;
    if (results.length === 0) {
      renderEmpty(query);
      return;
    }

    const sample = await Promise.all(results.slice(0, 50).map((result) => result.data()));
    if (token !== requestToken) return;
    const isRelevant = window.pagefindResultMatchesQuery ?? (() => true);
    const matched = sample.filter((data) => isRelevant(query, data));
    if (matched.length === 0) {
      renderEmpty(query);
      return;
    }

    const items = full ? matched : matched.slice(0, PREVIEW_LIMIT);
    renderResults(items, { full, total: matched.length });
  }

  function openOverlay() {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    input?.focus();
    void ensurePagefind();
  }

  function closeOverlay() {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    document.body.style.overflow = '';
    requestToken += 1;
    resetSearch();
  }

  trigger?.addEventListener('click', openOverlay);
  closeBtn?.addEventListener('click', closeOverlay);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeOverlay();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !overlay?.classList.contains('hidden')) closeOverlay();
  });

  input?.addEventListener('input', () => {
    lastQuery = input.value;
    void search(lastQuery, { full: false });
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      void search(input.value, { full: true });
    }
  });

  fullBtn?.addEventListener('click', () => {
    void search(lastQuery, { full: true });
  });
</script>
