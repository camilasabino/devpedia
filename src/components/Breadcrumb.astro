---
import { SITE_NAME } from '../config';
import { ui, type Lang } from '../i18n';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  lang: Lang;
  /** Ancestors of the current page, outermost first. The home crumb is added here. */
  crumbs: Crumb[];
}

const { lang, crumbs } = Astro.props;
const copy = ui[lang];
const items = [{ label: SITE_NAME, href: copy.homePath }, ...crumbs];
---

<nav aria-label={copy.breadcrumb} class="font-mono text-xs text-neutral-500 light:text-neutral-600">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          <a href={crumb.href} class="hover:text-accent-400 light:hover:text-accent-700">
            {crumb.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
