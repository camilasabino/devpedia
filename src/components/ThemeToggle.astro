---
import type { Lang } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const labelToLight = lang === 'es' ? 'Cambiar a modo claro' : 'Switch to light mode';
const labelToDark = lang === 'es' ? 'Cambiar a modo oscuro' : 'Switch to dark mode';
---

<button
  id="theme-toggle"
  type="button"
  data-label-light={labelToLight}
  data-label-dark={labelToDark}
  aria-label={labelToLight}
  class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 light:border-black/10 text-neutral-400 light:text-neutral-600 transition-colors hover:border-accent-400/40 hover:text-accent-400 light:hover:border-accent-600/40 light:hover:text-accent-700 sm:h-9 sm:w-9"
>
  <Icon name="moon" class="theme-toggle-moon h-4 w-4" />
  <Icon name="sun" class="theme-toggle-sun h-4 w-4" />
</button>

<style is:global>
  .theme-toggle-moon {
    display: none;
  }
  [data-theme='light'] .theme-toggle-sun {
    display: none;
  }
  [data-theme='light'] .theme-toggle-moon {
    display: inline;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');

  if (btn) {
    const sync = () => {
      const isLight = document.documentElement.hasAttribute('data-theme');
      btn.setAttribute('aria-label', isLight ? btn.dataset.labelDark! : btn.dataset.labelLight!);
    };
    sync();

    btn.addEventListener('click', () => {
      const isLight = document.documentElement.hasAttribute('data-theme');
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      }
      sync();
    });
  }
</script>
