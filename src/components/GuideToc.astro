---
// Table of contents of a guide, built from the headings its body actually renders.
// `sidebar` is the sticky column next to the guide on wide screens; `inline` is the
// collapsed block above the body below `lg`, so it never takes a screenful on mobile.
// Both are plain anchor lists that work without JavaScript; the script only adds the
// current-section highlight and closes the inline block after a jump.
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n';
import type { TocHeading } from '@/lib/guide';

interface Props {
  lang: Lang;
  headings: TocHeading[];
  variant: 'sidebar' | 'inline';
}

const { lang, headings, variant } = Astro.props;
const copy = ui[lang].guide.toc;
// Sections (h2) and subsections (h3) differ in weight, size, tone and indent, so the
// outline reads as a two-level tree. Both share the same current-section indicator.
const linkBase =
  'block border-l-2 border-transparent leading-snug hover:text-neutral-100 aria-[current=location]:border-accent-400 aria-[current=location]:text-accent-400 light:hover:text-neutral-900 light:aria-[current=location]:border-accent-700 light:aria-[current=location]:text-accent-700';
const sectionLink = `${linkBase} py-1.5 pl-3 text-sm font-medium text-neutral-200 light:text-neutral-800`;
const subsectionLink = `${linkBase} py-1 pl-6 text-[0.8125rem] text-neutral-400 light:text-neutral-600`;
---

{variant === 'sidebar' && (
  <nav data-guide-toc aria-label={copy.label}>
    <p
      class="font-mono text-xs uppercase tracking-widest text-neutral-500 light:text-neutral-600"
      aria-hidden="true"
    >
      {copy.eyebrow}
    </p>
    <ul class="mt-3">
      {headings.map((heading) => (
        <li class:list={[heading.depth === 2 && 'mt-3 first:mt-0']}>
          <a href={`#${heading.slug}`} class={heading.depth === 3 ? subsectionLink : sectionLink}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

{variant === 'inline' && (
  <details class="group rounded-2xl border border-white/10 bg-[linear-gradient(180deg,var(--surface-card-from),var(--surface-card-to))] light:border-black/10">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-4 py-3 font-mono text-xs uppercase tracking-widest text-neutral-400 light:text-neutral-600 [&::-webkit-details-marker]:hidden">
      {copy.eyebrow}
      <Icon
        name="chevronDown"
        class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
        decorative
      />
    </summary>
    <nav
      data-guide-toc
      data-close-on-navigate
      aria-label={copy.label}
      class="max-h-[60dvh] overflow-y-auto border-t border-white/10 px-4 pb-3 pt-2 light:border-black/10"
    >
      <ul>
        {headings.map((heading) => (
          <li class:list={[heading.depth === 2 && 'mt-3 first:mt-0']}>
            <a href={`#${heading.slug}`} class={heading.depth === 3 ? subsectionLink : sectionLink}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-guide-toc]')) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const headings = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length > 0) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let currentId = '';
      let locked = false;
      let unlockTimer = 0;

      const setCurrent = (id: string) => {
        if (id === currentId) {
          return;
        }
        currentId = id;
        for (const link of links) {
          if (decodeURIComponent(link.hash.slice(1)) === id) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      };

      const unlock = () => {
        locked = false;
      };

      const update = () => {
        if (locked) {
          return;
        }
        // Activate in the top fifth of the viewport so the highlight tracks the section
        // on screen, without jumping ahead when two headings are close together.
        const scanLine = Math.max(96, window.innerHeight * 0.2);
        let current = headings[0].id;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= scanLine) {
            current = heading.id;
          }
        }
        setCurrent(current);
      };

      for (const link of links) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            return;
          }
          const id = decodeURIComponent(link.hash.slice(1));
          const target = document.getElementById(id);
          if (!target) {
            return;
          }

          event.preventDefault();
          if (nav.hasAttribute('data-close-on-navigate')) {
            nav.closest('details')?.removeAttribute('open');
          }
          locked = true;
          setCurrent(id);
          history.pushState(null, '', link.hash);

          // Native hash scrolling from inside the sticky, scrollable sidebar stops short
          // of the heading (the last section never reaches the scan line).
          const margin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 88;
          const topOf = () =>
            Math.max(0, window.scrollY + target.getBoundingClientRect().top - margin);
          window.scrollTo({
            top: topOf(),
            behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
          });
          // Keyboard users continue from the heading they jumped to, not from the TOC.
          target.focus({ preventScroll: true });

          window.clearTimeout(unlockTimer);
          window.addEventListener(
            'scrollend',
            () => {
              // Diagrams render lazily as the scroll passes them and push the heading
              // down, so the first jump can stop short. Settle on the heading once.
              if (Math.abs(target.getBoundingClientRect().top - margin) > 4) {
                window.scrollTo({ top: topOf() });
              }
              unlock();
            },
            { once: true },
          );
          unlockTimer = window.setTimeout(unlock, 3000);
        });
      }

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) {
            return;
          }
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
      update();
    }
  }
</script>
